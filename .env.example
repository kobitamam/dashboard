# מחרוזת החיבור ל-MongoDB (Atlas או שרת עצמאי).
# לדוגמה: mongodb+srv://user:password@cluster.mongodb.net/ta-estate
# אם לא מציינים שם DB בסוף המחרוזת, המערכת תשתמש ב-"ta-estate".
#
# ב-MongoDB Atlas חובה גם לאשר גישה מהשרתים של Vercel:
# Network Access -> Add IP Address -> Allow access from anywhere (0.0.0.0/0)
MONGODB_URI=

# מפתח סודי לחתימת סשנים (NextAuth). ניתן להפיק עם: openssl rand -base64 32
AUTH_SECRET=

# Cloudflare R2 - אחסון קבצים מצורפים לתיקים (private bucket, גישה רק דרך signed URLs).
# מפיקים ב-Cloudflare Dashboard -> R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
